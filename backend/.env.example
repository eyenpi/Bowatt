BOWATT_ENVIRONMENT=development
BOWATT_HOST=0.0.0.0
BOWATT_PORT=8787
BOWATT_CORS_ORIGINS=http://localhost:5173
BOWATT_DEFAULT_WORKSPACE_ID=local-default
BOWATT_MAX_UPLOAD_FILES=10
BOWATT_MAX_UPLOAD_BYTES=5000000
BOWATT_MAX_REQUEST_CHARACTERS=10000
BOWATT_DATABASE_PATH=data/research.db
BOWATT_CHUNK_SIZE=2000
BOWATT_CHUNK_OVERLAP=200
BOWATT_CHUNK_MAX_TOKENS=512
BOWATT_EMBEDDING_BATCH_SIZE=64
BOWATT_EMBEDDING_CONCURRENCY=4
BOWATT_EMBEDDING_MODEL=text-embedding-3-small
# BOWATT_EMBEDDING_DIMENSIONS=1536
BOWATT_EMBEDDING_TIMEOUT_SECONDS=30
BOWATT_RETRIEVAL_LIMIT=5
BOWATT_RESEARCH_MODEL=gpt-5.5
BOWATT_RESEARCH_PROVIDER_TIMEOUT_SECONDS=60
BOWATT_RESEARCH_MAX_OUTPUT_TOKENS=3000
BOWATT_RESEARCH_STREAM_IDLE_TIMEOUT_SECONDS=30
BOWATT_RESEARCH_STREAM_CLOSE_TIMEOUT_SECONDS=2
BOWATT_RESEARCH_MAX_SEARCH_ROUNDS=2
BOWATT_RESEARCH_QUERIES_PER_ROUND=3
BOWATT_RESEARCH_SEARCH_RESULTS_PER_QUERY=5
BOWATT_RESEARCH_SEARCH_CONCURRENCY=3
BOWATT_RESEARCH_SEARCH_MAX_ATTEMPTS=2
BOWATT_RESEARCH_SEARCH_RETRY_DELAY_SECONDS=0.2
BOWATT_RESEARCH_SEARCH_TIMEOUT_SECONDS=30
BOWATT_RESEARCH_MAX_WEB_RESULTS=12
BOWATT_RESEARCH_MAX_QUERY_CHARACTERS=500
BOWATT_RESEARCH_MAX_SNIPPET_CHARACTERS=2000
